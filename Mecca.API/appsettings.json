{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Google": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "SendGrid": {
    "ApiKey": "",
    "FromEmail": "",
    "FromName": ""
  },
  "ClientUrl": "http://localhost:5173",
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Forwarded-For",
    "HttpStatusCode": 429,
    "QuotaExceededResponse": {
      "Content": "{{\"code\":\"RATE_LIMITED\",\"message\":\"Too many attempts, please try again later.\"}}",
      "ContentType": "application/json",
      "StatusCode": 429
    },
    "GeneralRules": [
      {
        "Endpoint": "POST:/api/auth/login",
        "Period": "15m",
        "Limit": 5
      },
      {
        "Endpoint": "POST:/api/auth/register",
        "Period": "1h",
        "Limit": 10
      },
      {
        "Endpoint": "GET:/api/auth/check-email",
        "Period": "1m",
        "Limit": 30
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}